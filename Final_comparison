{"id":"D5IzjUEC6h9C"}},{"cell_type":"code","source":["reference = load_checkpoint(\"Cosine DDPM + attention\")\n","\n","validation_source = datasets.CIFAR10(\n","    root=str(PROJECT_DIR / \"data\"),\n","    train=True,\n","    download=True,\n","    transform=transforms.Compose([\n","        transforms.ToTensor(),\n","        transforms.Normalize((0.5,) * 3, (0.5,) * 3)\n","    ])\n",")\n","\n","fixed_indices = reference[\"val_indices\"][:16]\n","\n","fixed_real = torch.stack([\n","    validation_source[index][0]\n","    for index in fixed_indices\n","])\n","\n","fixed_z = torch.randn(\n","    16,\n","    LATENT_DIM,\n","    generator=torch.Generator().manual_seed(123)\n",")\n","\n","panels = {\n","    \"Real validation images\": (\n","        (fixed_real + 1) / 2\n","    ).clamp(0, 1)\n","}\n","\n","panel_epochs = {}\n","\n","\n","def verify_split(saved):\n","    assert list(saved[\"val_indices\"]) == list(\n","        reference[\"val_indices\"]\n","    ), \"Validation splits differ.\""],"metadata":{"id":"eOkpXsXY6jdj"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Generate AE, VAE, and DCGAN panels"],"metadata":{"id":"HrkC6SI46mq0"}},{"cell_type":"code","source":["import torch\n","import torch.nn as nn\n","\n","LATENT_DIM = 128\n","\n","\n","class Encoder(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","\n","        self.net = nn.Sequential(\n","            nn.Conv2d(3, 32, 4, 2, 1),\n","            nn.ReLU(),\n","            nn.Conv2d(32, 64, 4, 2, 1),\n","            nn.ReLU(),\n","            nn.Conv2d(64, 128, 4, 2, 1),\n","            nn.ReLU(),\n","            nn.Flatten()\n","        )\n","\n","    def forward(self, x):\n","        return self.net(x)\n","\n","\n","class Decoder(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","\n","        self.fc = nn.Linear(LATENT_DIM, 128 * 4 * 4)\n","\n","        self.net = nn.Sequential(\n","            nn.ConvTranspose2d(128, 64, 4, 2, 1),\n","            nn.ReLU(),\n","            nn.ConvTranspose2d(64, 32, 4, 2, 1),\n","            nn.ReLU(),\n","            nn.ConvTranspose2d(32, 3, 4, 2, 1),\n","            nn.Tanh()\n","        )\n","\n","    def forward(self, z):\n","        return self.net(\n","            self.fc(z).reshape(-1, 128, 4, 4)\n","        )\n","\n","\n","class Autoencoder(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","\n","        self.encoder = Encoder()\n","        self.latent = nn.Linear(128 * 4 * 4, LATENT_DIM)\n","        self.decoder = Decoder()\n","\n","    def forward(self, x):\n","        return self.decoder(\n","            self.latent(self.encoder(x))\n","        )"],"metadata":{"id":"CTlBdAoT7Wdb"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["class VAE(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","\n","        self.encoder = Encoder()\n","        self.mu = nn.Linear(128 * 4 * 4, LATENT_DIM)\n","        self.logvar = nn.Linear(128 * 4 * 4, LATENT_DIM)\n","        self.decoder = Decoder()\n","\n","    def forward(self, x):\n","        features = self.encoder(x)\n","\n","        mu = self.mu(features)\n","        logvar = self.logvar(features)\n","\n","        z = (\n","            mu\n","            + torch.exp(0.5 * logvar)\n","            * torch.randn_like(mu)\n","        )\n","\n","        return self.decoder(z), mu, logvar\n","\n","\n","class Generator(nn.Module):\n","    def __init__(self):\n","        super().__init__()\n","\n","        self.net = nn.Sequential(\n","            nn.ConvTranspose2d(\n","                LATENT_DIM, 256, 4, 1, 0, bias=False\n","            ),\n","            nn.BatchNorm2d(256),\n","            nn.ReLU(),\n","\n","            nn.ConvTranspose2d(\n","                256, 128, 4, 2, 1, bias=False\n","            ),\n","            nn.BatchNorm2d(128),\n","            nn.ReLU(),\n","\n","            nn.ConvTranspose2d(\n","                128, 64, 4, 2, 1, bias=False\n","            ),\n","            nn.BatchNorm2d(64),\n","            nn.ReLU(),\n","\n","            nn.ConvTranspose2d(\n","                64, 3, 4, 2, 1, bias=False\n","            ),\n","            nn.Tanh()\n","        )\n","\n","    def forward(self, z):\n","        return self.net(z[:, :, None, None])"],"metadata":{"id":"D0bC-Gsd7gDz"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["# AE\n","saved = load_checkpoint(\"AE\")\n","verify_split(saved)\n","assert saved[\"latent_dim\"] == LATENT_DIM\n","\n","model = Autoencoder().to(device)\n","model.load_state_dict(saved[\"model\"])\n","model.eval()\n","\n","with torch.inference_mode():\n","    output = model(fixed_real.to(device))\n","\n","panels[\"AE reconstructions\"] = (\n","    (output + 1) / 2\n",").clamp(0, 1).cpu()\n","\n","panel_epochs[\"AE reconstructions\"] = saved[\"epoch\"]\n","\n","del model, output, saved\n","release_gpu_memory()\n","\n","\n","# VAE\n","saved = load_checkpoint(\"VAE\")\n","verify_split(saved)\n","assert saved[\"latent_dim\"] == LATENT_DIM\n","\n","model = VAE().to(device)\n","model.load_state_dict(saved[\"model\"])\n","model.eval()\n","\n","with torch.inference_mode():\n","    output = model.decoder(fixed_z.to(device))\n","\n","panels[\"VAE samples\"] = (\n","    (output + 1) / 2\n",").clamp(0, 1).cpu()\n","\n","panel_epochs[\"VAE samples\"] = saved[\"epoch\"]\n","\n","del model, output, saved\n","release_gpu_memory()\n","\n","\n","# DCGAN\n","saved = load_checkpoint(\"DCGAN\")\n","verify_split(saved)\n","assert saved[\"latent_dim\"] == LATENT_DIM\n","\n","model = Generator().to(device)\n","model.load_state_dict(saved[\"generator\"])\n","model.eval()\n","\n","with torch.inference_mode():\n","    output = model(fixed_z.to(device))\n","\n","panels[\"DCGAN samples\"] = (\n","    (output + 1) / 2\n",").clamp(0, 1).cpu()\n","\n","panel_epochs[\"DCGAN samples\"] = saved[\"epoch\"]\n","\n","del model, output, saved\n","release_gpu_memory()"],"metadata":{"id":"ywtTTRkE6num"},"execution_count":null,"outputs":[]},{"cell_type":"markdown","source":["# Generate the three DDPM panels"],"metadata":{"id":"fbx-GV3t6vFH"}},{"cell_type":"code","source":["import math\n","import torch\n","import torch.nn as nn\n","import torch.nn.functional as F\n","\n","\n","class SinusoidalTimeEmbedding(nn.Module):\n","    def __init__(self, embedding_dim):\n","        super().__init__()\n","\n","        half_dim = embedding_dim // 2\n","\n","        frequencies = torch.exp(\n","            -math.log(10000)\n","            * torch.arange(half_dim, dtype=torch.float32)\n","            / (half_dim - 1)\n","        )\n","\n","        self.register_buffer(\"frequencies\", frequencies)\n","\n","    def forward(self, timesteps):\n","        angles = (\n","            timesteps.float().unsqueeze(1)\n","            * self.frequencies.unsqueeze(0)\n","        )\n","\n","        return torch.cat(\n","            [angles.sin(), angles.cos()],\n","            dim=1\n","        )\n","\n","\n","class TimeResidualBlock(nn.Module):\n","    def __init__(\n","        self,\n","        in_channels,\n","        out_channels,\n","        time_dim,\n","        dropout=0.1\n","    ):\n","        super().__init__()\n","\n","        self.norm1 = nn.GroupNorm(8, in_channels)\n","        self.conv1 = nn.Conv2d(\n","            in_channels, out_channels, 3, padding=1\n","        )\n","\n","        self.time_projection = nn.Sequential(\n","            nn.SiLU(),\n","            nn.Linear(time_dim, out_channels)\n","        )\n","\n","        self.norm2 = nn.GroupNorm(8, out_channels)\n","        self.dropout = nn.Dropout(dropout)\n","\n","        self.conv2 = nn.Conv2d(\n","            out_channels, out_channels, 3, padding=1\n","        )\n","\n","        self.shortcut = (\n","            nn.Identity()\n","            if in_channels == out_channels\n","            else nn.Conv2d(in_channels, out_channels, 1)\n","        )\n","\n","    def forward(self, x, time_embedding):\n","        h = self.conv1(F.silu(self.norm1(x)))\n","\n","        h = h + self.time_projection(\n","            time_embedding\n","        )[:, :, None, None]\n","\n","        h = self.conv2(\n","            self.dropout(F.silu(self.norm2(h)))\n","        )\n","\n","        return h + self.shortcut(x)\n","\n","\n","class SpatialAttention(nn.Module):\n","    def __init__(self, channels, num_heads=4):\n","        super().__init__()\n","\n","        self.norm = nn.GroupNorm(8, channels)\n","\n","        self.attention = nn.MultiheadAttention(\n","            embed_dim=channels,\n","            num_heads=num_heads,\n","            batch_first=True\n","        )\n","\n","    def forward(self, x):\n","        batch, channels, height, width = x.shape\n","\n","        h = self.norm(x).flatten(2).transpose(1, 2)\n","\n","        h, _ = self.attention(\n","            h, h, h,\n","            need_weights=False\n","        )\n","\n","        h = h.transpose(1, 2).reshape(\n","            batch, channels, height, width\n","        )\n","\n","        return x + h\n","\n","\n","class DiffusionUNet(nn.Module):\n","    def __init__(\n","        self,\n","        image_channels=3,\n","        base_channels=64,\n","        time_dim=256,\n","        dropout=0.1\n","    ):\n","        super().__init__()\n","\n","        c = base_channels\n","\n","        self.time_mlp = nn.Sequential(\n","            SinusoidalTimeEmbedding(c),\n","            nn.Linear(c, time_dim),\n","            nn.SiLU(),\n","            nn.Linear(time_dim, time_dim)\n","        )\n","\n","        self.input_conv = nn.Conv2d(\n","            image_channels, c, 3, padding=1\n","        )\n","\n","        self.encoder1 = TimeResidualBlock(\n","            c, c, time_dim, dropout\n","        )\n","\n","        self.downsample1 = nn.Conv2d(\n","            c, 2 * c, 4, stride=2, padding=1\n","        )\n","\n","        self.encoder2 = TimeResidualBlock(\n","            2 * c, 2 * c, time_dim, dropout\n","        )\n","\n","        self.encoder_attention = SpatialAttention(2 * c)\n","\n","        self.downsample2 = nn.Conv2d(\n","            2 * c, 4 * c, 4, stride=2, padding=1\n","        )\n","\n","        self.middle1 = TimeResidualBlock(\n","            4 * c, 4 * c, time_dim, dropout\n","        )\n","\n","        self.middle_attention = SpatialAttention(4 * c)\n","\n","        self.middle2 = TimeResidualBlock(\n","            4 * c, 4 * c, time_dim, dropout\n","        )\n","\n","        self.upsample1 = nn.Sequential(\n","            nn.Upsample(scale_factor=2, mode=\"nearest\"),\n","            nn.Conv2d(4 * c, 2 * c, 3, padding=1)\n","        )\n","\n","        self.decoder2 = TimeResidualBlock(\n","            4 * c, 2 * c, time_dim, dropout\n","        )\n","\n","        self.decoder_attention = SpatialAttention(2 * c)\n","\n","        self.upsample2 = nn.Sequential(\n","            nn.Upsample(scale_factor=2, mode=\"nearest\"),\n","            nn.Conv2d(2 * c, c, 3, padding=1)\n","        )\n","\n","        self.decoder1 = TimeResidualBlock(\n","            2 * c, c, time_dim, dropout\n","        )\n","\n","        self.output_norm = nn.GroupNorm(8, c)\n","\n","        self.output_conv = nn.Conv2d(\n","            c, image_channels, 3, padding=1\n","        )\n","\n","    def forward(self, x, timesteps):\n","        embedding = self.time_mlp(timesteps)\n","\n","        skip1 = self.encoder1(\n","            self.input_conv(x), embedding\n","        )\n","\n","        skip2 = self.encoder2(\n","            self.downsample1(skip1), embedding\n","        )\n","\n","        skip2 = self.encoder_attention(skip2)\n","\n","        x = self.downsample2(skip2)\n","        x = self.middle1(x, embedding)\n","        x = self.middle_attention(x)\n","        x = self.middle2(x, embedding)\n","\n","        x = self.upsample1(x)\n","\n","        x = self.decoder2(\n","            torch.cat([x, skip2], dim=1),\n","            embedding\n","        )\n","\n","        x = self.decoder_attention(x)\n","        x = self.upsample2(x)\n","\n","        x = self.decoder1(\n","            torch.cat([x, skip1], dim=1),\n","            embedding\n","        )\n","\n","        return self.output_conv(\n","            F.silu(self.output_norm(x))\n","        )\n","\n","\n","class NoAttentionUNet(DiffusionUNet):\n","    def __init__(self, **kwargs):\n","        super().__init__(**kwargs)\n","\n","        self.encoder_attention = nn.Identity()\n","        self.middle_attention = nn.Identity()\n","        self.decoder_attention = nn.Identity()"],"metadata":{"id":"SBUw3Nze71F9"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["import torch\n","from tqdm.auto import tqdm\n","\n","\n","@torch.no_grad()\n","def generate_samples(\n","    model,\n","    saved_betas,\n","    num_images=16,\n","    seed=123,\n","    show_progress=True\n","):\n","    model_device = next(model.parameters()).device\n","    betas = saved_betas.to(model_device)\n","\n","    alphas = 1.0 - betas\n","    alpha_bars = torch.cumprod(alphas, dim=0)\n","\n","    previous_bars = torch.cat([\n","        torch.ones(1, device=model_device),\n","        alpha_bars[:-1]\n","    ])\n","\n","    variance = (\n","        betas * (1.0 - previous_bars)\n","        / (1.0 - alpha_bars)\n","    )\n","\n","    coef1 = (\n","        betas * previous_bars.sqrt()\n","        / (1.0 - alpha_bars)\n","    )\n","\n","    coef2 = (\n","        (1.0 - previous_bars) * alphas.sqrt()\n","        / (1.0 - alpha_bars)\n","    )\n","\n","    generator = torch.Generator(\n","        device=model_device\n","    ).manual_seed(seed)\n","\n","    x = torch.randn(\n","        num_images, 3, 32, 32,\n","        device=model_device,\n","        generator=generator\n","    )\n","\n","    was_training = model.training\n","    model.eval()\n","\n","    try:\n","        for step in tqdm(\n","            reversed(range(len(betas))),\n","            total=len(betas),\n","            desc=\"Generating images\",\n","            disable=not show_progress\n","        ):\n","            t = torch.full(\n","                (num_images,),\n","                step,\n","                dtype=torch.long,\n","                device=model_device\n","            )\n","\n","            predicted_noise = model(x, t)\n","\n","            predicted_x0 = (\n","                x\n","                - (1.0 - alpha_bars[step]).sqrt()\n","                * predicted_noise\n","            ) / alpha_bars[step].sqrt()\n","\n","            predicted_x0 = predicted_x0.clamp(-1, 1)\n","\n","            mean = (\n","                coef1[step] * predicted_x0\n","                + coef2[step] * x\n","            )\n","\n","            if step > 0:\n","                noise = torch.randn(\n","                    x.shape,\n","                    device=model_device,\n","                    generator=generator\n","                )\n","\n","                x = mean + variance[step].sqrt() * noise\n","            else:\n","                x = mean\n","\n","        return ((x + 1) / 2).clamp(0, 1).cpu()\n","\n","    finally:\n","        model.train(was_training)"],"metadata":{"id":"Ruh3b8mu7_eT"},"execution_count":null,"outputs":[]},{"cell_type":"code","source":["for name in [\n","    \"Cosine DDPM + attention\",\n","    \"Linear DDPM + attention\",\n","    \"Linear DDPM without attention\"\n","]:\n","    saved = load_checkpoint(name)\n","    verify_split(saved)\n","\n","    model_class = (\n","        NoAttentionUNet\n","        if name == \"Linear DDPM without attention\"\n","        else DiffusionUNet\n","    )\n","\n","    model = model_class(\n","        **saved[\"model_config\"]\n","    ).to(device)\n","\n","    model.load_state_dict(saved[\"model_state_dict\"])\n","\n","    panels[name] = generate_samples(\n","        model,\n","        saved[\"betas\"],\n","        num_images=16,\n","        seed=123,\n","        show_progress=True\n","    ).detach().cpu()\n","\n","    panel_epochs[name] = saved[\"epoch\"]